 # ``./isaaclab.sh -i``. Workspace members resolve to ``source/`` via [tool.uv.sources].
 dependencies = [
+    "protomotions[isaaclab]",
+    "wheel",
+    "tensordict>=0.9",
+    "lightning",
+    "numpy>=1.21.1",
+    "scipy>=1.11",
+    "scikit-image",
+    "rtree>=1.2",
+    "trimesh",
+    "setuptools>=69.5.1",
+    "packaging>=23.0",
+    "filelock>=3.0",
+    "PyYAML>=6",
+    "omegaconf>=2.3",
+    "rich",
+    "typer>=0.6.1",
+    "matplotlib",
+    "easydict",
