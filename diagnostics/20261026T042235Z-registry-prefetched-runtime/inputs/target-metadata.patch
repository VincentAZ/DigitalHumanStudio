-    "pytetwild==0.2.3 ; platform_machine in 'x86_64 AMD64'",
-    "pytetwild[all]>=0.3.0,<0.4 ; platform_machine in 'aarch64 arm64'",
+    "pytetwild==0.2.3 ; (platform_machine == 'x86_64' or platform_machine == 'AMD64')",
+    "pytetwild[all]>=0.3.0,<0.4 ; (platform_machine == 'aarch64' or platform_machine == 'arm64')",
     "transformers==4.57.6",
     "einops",
     "warp-lang==1.15.0.dev20260626",
@@ -57,16 +79,16 @@
     "lazy_loader>=0.4",
     # Pink IK stack; the install CLI derives its force-install list from these entries.
     # pin-pink: Isaac Sim 6.x needs >=3.3, 3.4+ breaks pink_ik; daqp >0.8.5 changes behavior.
-    "pin ; platform_system == 'Linux' and platform_machine in 'x86_64 AMD64 aarch64 arm64'",
-    "pin-pink==3.3.0 ; platform_system == 'Linux' and platform_machine in 'x86_64 AMD64 aarch64 arm64'",
