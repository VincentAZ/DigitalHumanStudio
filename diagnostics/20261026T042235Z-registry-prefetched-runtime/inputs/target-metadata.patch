     # avoid broken hf-xet pre-release cached on NVIDIA Artifactory
-    "hf-xet>=1.4.1,<2.0.0 ; platform_machine in 'x86_64 AMD64 aarch64 arm64'",
+    "hf-xet>=1.4.1,<2.0.0 ; (platform_machine == 'x86_64' or platform_machine == 'AMD64' or platform_machine == 'aarch64' or platform_machine == 'arm64')",
     # ----- tasks -----
     "tensorboard",
     "numba>=0.63.1",
