-    "usd-core>=25.11,<26.0 ; platform_machine in 'x86_64 AMD64'",
-    "usd-exchange>=2.2 ; platform_machine in 'aarch64 arm64'",
+    "usd-core>=25.11,<26.0 ; (platform_machine == 'x86_64' or platform_machine == 'AMD64')",
